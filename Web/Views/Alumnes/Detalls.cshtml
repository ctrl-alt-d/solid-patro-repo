@model LogicaDeNegoci.Abstractions.Projeccions.ProjeccioAlumne

@{
    ViewData["Title"] = "Detalls alumne";
}

<h1>@Model.Nom</h1>

<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Curs</dt>
    <dd class="col-sm-10">@Model.Curs</dd>

    <dt class="col-sm-2">Estudis finalitzats</dt>
    <dd class="col-sm-10">@(Model.EstudisFinalitzats ? "Sí" : "No")</dd>
</dl>

@if (!Model.EstudisFinalitzats)
{
    <form asp-action="Promocionar" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary">Promocionar</button>
    </form>
}

<p class="mt-3">
    <a asp-action="Index">Tornar a la llista</a>
</p>
